# Cabinet Backend (Rust + Axum) Environment Configuration

HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/atlas?schema=public
REDIS_URL=redis://127.0.0.1:6379
SESSION_SECRET=change-this-to-a-very-secure-random-secret-key-32-chars-minimum
FRONTEND_URL=http://localhost:3000
COOKIE_DOMAIN=localhost
MAX_DB_CONNECTIONS=15

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cabinet
R2_PUBLIC_URL=

# Concurrency limits (Tuned for VPS 2GB RAM)
INTERACTIVE_WORKER_CONCURRENCY=4
BULK_WORKER_CONCURRENCY=2
IMAGE_RESIZE_CONCURRENCY=1
