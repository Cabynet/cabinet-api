# Cabinet Backend (Rust + Axum) Environment Configuration

HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/atlas?schema=public
REDIS_URL=redis://127.0.0.1:6379
API_URL=http://localhost:4000
# Signs proxy-image/proxy-page URLs. Required when API_URL is https (generate: openssl rand -hex 32).
PROXY_SIGNING_KEY=
# true only when the API sits behind a reverse proxy that sets X-Forwarded-For (compose default).
TRUSTED_PROXY=false
FRONTEND_URL=http://localhost:3000
# Parent domain shared by web and API (e.g. example.com); leave empty for a host-only cookie.
COOKIE_DOMAIN=
MAX_DB_CONNECTIONS=15

# Cloudflare R2 Object Storage
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cabinet
R2_PUBLIC_URL=

# Concurrency limits (Tuned for VPS 2GB RAM)
INTERACTIVE_WORKER_CONCURRENCY=4
BULK_WORKER_CONCURRENCY=2
